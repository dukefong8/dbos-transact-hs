cabal-version:      3.0
name:               dbos-scope-proto
version:            0.1.0.0
synopsis:
  THROWAWAY prototype for the §11 phantom-brand direction. NOT FOR PRODUCTION.
description:
  Throwaway prototype validating the decided phantom-brand direction
  (docs/ownership-lifetimes-isomorphism.md §11): @inst@-scoped
  connections\/registries\/refs\/handles, per-execution @exec@-scoped
  workflow\/step contexts, rank-2 region binders. Lives on the
  proto/phantom-brands throwaway branch only; main keeps nothing but
  the validated decision. Findings are consolidated in
  docs/scoped-workflow-capabilities.md (same branch).
license:            NONE
build-type:         Simple

library
  hs-source-dirs:   src
  exposed-modules:  Scope.Model
  build-depends:
      base
    , containers
    , io-classes
    , io-classes:strict-mvar
    , io-classes:strict-stm
    , text
  default-language: Haskell2010
  ghc-options:      -Wall

executable proto-io
  main-is:          Main.hs
  hs-source-dirs:   app-io
  build-depends:
      base
    , dbos-scope-proto
    , io-classes
    , io-classes:strict-mvar
    , io-classes:strict-stm
    , text
  default-language: Haskell2010
  ghc-options:      -Wall

executable proto-sim
  main-is:          Main.hs
  hs-source-dirs:   app-sim
  build-depends:
      base
    , dbos-scope-proto
    , io-classes
    , io-classes:strict-mvar
    , io-classes:strict-stm
    , io-sim
    , text
  default-language: Haskell2010
  ghc-options:      -Wall

-- Negative compile tests: each MUST FAIL to build. Built one by one by
-- run.sh (never as part of `cabal build all` succeeding). -fno-code:
-- typecheck only, no linking.
executable neg-n2-step-start
  main-is:          N2_StepStart.hs
  hs-source-dirs:   neg
  build-depends:    base, dbos-scope-proto, io-classes, io-classes:strict-mvar, io-classes:strict-stm, text
  default-language: Haskell2010
  ghc-options:      -fno-code -w

executable neg-n4-nextid-on-step
  main-is:          N4_NextIdOnStep.hs
  hs-source-dirs:   neg
  build-depends:    base, dbos-scope-proto, io-classes, io-classes:strict-mvar, io-classes:strict-stm, text
  default-language: Haskell2010
  ghc-options:      -fno-code -w

executable neg-n5-cross-exec-drive
  main-is:          N5_CrossExecDrive.hs
  hs-source-dirs:   neg
  build-depends:    base, dbos-scope-proto, io-classes, io-classes:strict-mvar, io-classes:strict-stm, text
  default-language: Haskell2010
  ghc-options:      -fno-code -w

executable neg-n6-cross-run
  main-is:          N6_CrossRun.hs
  hs-source-dirs:   neg
  build-depends:    base, dbos-scope-proto, io-classes, io-classes:strict-mvar, io-classes:strict-stm, io-sim, text
  default-language: Haskell2010
  ghc-options:      -fno-code -w

-- Runtime-backstop checks: the capture shape compiles, so this asserts
-- it is refused at runtime, plus depth restoration and per-attempt scope.
executable neg-n7-pin-cross-exec
  main-is:          N7_PinCrossExec.hs
  hs-source-dirs:   neg
  build-depends:    base, dbos-scope-proto, io-classes, io-classes:strict-mvar, io-classes:strict-stm, text
  default-language: Haskell2010
  ghc-options:      -fno-code -w

-- Witness controls: each is its negative with the one illegal token
-- fixed. MUST BUILD CLEAN; if one stops compiling, its negative is
-- vacuous. -fno-code: typecheck only, matching the negatives.
executable w-n2-start-with-ctx
  main-is:          W_N2_StartWithCtx.hs
  hs-source-dirs:   neg
  build-depends:    base, dbos-scope-proto, io-classes, io-classes:strict-mvar, io-classes:strict-stm, text
  default-language: Haskell2010
  ghc-options:      -fno-code -w

executable w-n4-nextid-on-ctx
  main-is:          W_N4_NextIdOnCtx.hs
  hs-source-dirs:   neg
  build-depends:    base, dbos-scope-proto, io-classes, io-classes:strict-mvar, io-classes:strict-stm, text
  default-language: Haskell2010
  ghc-options:      -fno-code -w

executable w-n5-same-exec-drive
  main-is:          W_N5_SameExecDrive.hs
  hs-source-dirs:   neg
  build-depends:    base, dbos-scope-proto, io-classes, io-classes:strict-mvar, io-classes:strict-stm, text
  default-language: Haskell2010
  ghc-options:      -fno-code -w

executable w-n6-same-run
  main-is:          W_N6_SameRun.hs
  hs-source-dirs:   neg
  build-depends:    base, dbos-scope-proto, io-classes, io-classes:strict-mvar, io-classes:strict-stm, io-sim, text
  default-language: Haskell2010
  ghc-options:      -fno-code -w

executable w-n7-same-exec-pin
  main-is:          W_N7_SameExecPin.hs
  hs-source-dirs:   neg
  build-depends:    base, dbos-scope-proto, io-classes, io-classes:strict-mvar, io-classes:strict-stm, text
  default-language: Haskell2010
  ghc-options:      -fno-code -w

executable proto-backstop
  main-is:          Main.hs
  hs-source-dirs:   app-backstop
  build-depends:
      base, dbos-scope-proto, io-classes, io-classes:strict-mvar, io-classes:strict-stm, io-sim, text
  default-language: Haskell2010
  ghc-options:      -Wall
