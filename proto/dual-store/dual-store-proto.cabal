cabal-version:      3.0
name:               dual-store-proto
version:            0.1.0.0
synopsis:
  THROWAWAY prototype for dual-stack transactional stores. NOT FOR PRODUCTION.
description:
  Throwaway probe: one widget-store workflow source against two
  transaction handlers — Postgres transactions under IO, STM under
  IOSim. Operations are atomic on both stacks; a concurrent stock race,
  a write-then-throw rollback, and an insufficient-stock refusal print
  identical invariant lines either way. Lives on the
  proto/phantom-brands throwaway branch only. Findings in README.md
  (same directory).
license:            NONE
build-type:         Simple

library
  hs-source-dirs:   src
  exposed-modules:  Store.Model
  build-depends:
      base
    , containers
    , io-classes
    , io-classes:strict-mvar
    , io-classes:strict-stm
    , text
  default-language: Haskell2010
  default-extensions: OverloadedStrings, RankNTypes, ScopedTypeVariables, DerivingStrategies
  ghc-options:      -Wall

executable proto-io
  main-is:          Main.hs
  hs-source-dirs:   app-io
  build-depends:
      base
    , bytestring
    , contravariant
    , dual-store-proto
    , hasql >=1.10 && <1.11
    , text
  default-language: Haskell2010
  default-extensions: OverloadedStrings, ImportQualifiedPost
  ghc-options:      -Wall

executable proto-sim
  main-is:          Main.hs
  hs-source-dirs:   app-sim
  build-depends:
      base
    , containers
    , dual-store-proto
    , io-classes
    , io-classes:strict-mvar
    , io-classes:strict-stm
    , io-sim
    , text
  default-language: Haskell2010
  default-extensions: OverloadedStrings
  ghc-options:      -Wall

-- Negative compile tests: each MUST FAIL to build. Built one by one by
-- run.sh (never as part of `cabal build all` succeeding). -fno-code:
-- typecheck only, no linking.
executable neg-step-cross-stack
  main-is:          NegStepCrossStack.hs
  hs-source-dirs:   neg
  build-depends:    base, dual-store-proto, io-classes, io-classes:strict-mvar, io-classes:strict-stm, io-sim, text
  default-language: Haskell2010
  default-extensions: OverloadedStrings
  ghc-options:      -fno-code -w
