cabal-version: 3.6
name: dbos-transact-hs
version: 0.1.0.0
build-type: Simple

common commons
  default-language: GHC2024
  default-extensions:
    DuplicateRecordFields
    NoFieldSelectors
    NoImplicitPrelude
    NoMonomorphismRestriction
    OverloadedLabels
    OverloadedRecordDot
    RecordWildCards
  ghc-options: -Wall -threaded
  build-depends:
    aeson,
    base >=4.21 && <5,
    base64-bytestring,
    bytestring,
    containers,
    contra-tracer >=0.2.1 && <0.3,
    contravariant,
    fast-logger >=3.2.7 && <3.3,
    hasql >=1.10 && <1.11,
    hasql-pool,
    hasql-postgresql-types,
    hasql-transaction,
    ihp-typed-sql,
    io-classes,
    io-classes:mtl,
    io-classes:si-timers,
    io-classes:strict-mvar,
    io-classes:strict-stm,
    io-sim,
    mtl,
    postgresql-types,
    rerefined,
    safe-wild-cards,
    stm-containers,
    strict-wrapper,
    template-haskell,
    text,
    time,
    unordered-containers,
    uuid,
    vector,

library dbos-transact-internals
  import: commons
  visibility: private
  hs-source-dirs: src/DBOS/Internal
  exposed-modules:
    DBOS.Prelude
    DBOS.Transact.Checkpoint
    DBOS.Transact.Client
    DBOS.Transact.Config
    DBOS.Transact.Connection
    DBOS.Transact.Context
    DBOS.Transact.Datasource
    DBOS.Transact.Datasource.Postgres
    DBOS.Transact.Dequeue
    DBOS.Transact.Error
    DBOS.Transact.Event
    DBOS.Transact.Handle
    DBOS.Transact.Identity
    DBOS.Transact.Instance
    DBOS.Transact.Management
    DBOS.Transact.Message
    DBOS.Transact.Queue
    DBOS.Transact.Recovery
    DBOS.Transact.Registry
    DBOS.Transact.Select
    DBOS.Transact.Serialization
    DBOS.Transact.Sleep
    DBOS.Transact.Step
    DBOS.Transact.Wait
    DBOS.Transact.Workflow
    DBOS.Tracer
    DBOS.SystemDB.Class
    DBOS.SystemDB.Error
    DBOS.SystemDB.Notify
    DBOS.SystemDB.Postgres.Backend
    DBOS.SystemDB.Postgres.Notifier
    DBOS.SystemDB.Postgres.Statements
    DBOS.SystemDB.Retry
    DBOS.SystemDB.Types

library
  import: commons
  hs-source-dirs: src
  exposed-modules:
    DBOS.SystemDB
    DBOS.SystemDB.Postgres
    DBOS.Transact
  build-depends:
    dbos-transact-hs:dbos-transact-internals

test-suite test
  import: commons
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    -- PARKED while the Postgres backend is rewritten: ghciwatch and
    -- `cabal build test` cover the DBOS.SystemDB slice only.
    DBOS.Transact.SerializationTest
    DBOS.TracerTest
    DBOS.DualStack
    DBOS.IOSimTracer
    DBOS.SystemDB.TypesTest
    DBOS.SystemDB.ErrorTest
    DBOS.SystemDB.IOSim
    DBOS.SystemDB.IOSimTest
    DBOS.SystemDB.RetryTest
    DBOS.SystemDB.PostgresTest
    DBOS.Transact.CheckpointCases
    DBOS.Transact.CheckpointTest
    DBOS.Transact.CheckpointTestSim
    DBOS.Transact.ClientTest
    DBOS.Transact.ConfigTest
    DBOS.Transact.ContextTest
    DBOS.Transact.ContextTestSim
    DBOS.Transact.DatasourceCases
    DBOS.Transact.DatasourceTest
    DBOS.Transact.DatasourceTestSim
    DBOS.Transact.QueueTestSim
    DBOS.Transact.WidgetTest
    DBOS.Transact.WidgetCases
    DBOS.Transact.WidgetSim
    DBOS.Transact.ContextSimData
    DBOS.Transact.DeadlinesCases
    DBOS.Transact.DeadlinesTest
    DBOS.Transact.DeadlinesTestSim
    DBOS.Transact.HandleTest
    DBOS.Transact.HandleTestSim
    DBOS.Transact.IdentityTest
    DBOS.Transact.RegistryTest
    DBOS.Transact.SelectCases
    DBOS.Transact.SelectTest
    DBOS.Transact.SelectTestSim
    DBOS.Transact.StepRetryCases
    DBOS.Transact.StepRetryTest
    DBOS.Transact.StepRetryTestSim
    DBOS.Transact.StepTestSim
    DBOS.Transact.StepTest
    DBOS.Transact.ErrorTest
    DBOS.Transact.EventTest
    DBOS.Transact.MessageCases
    DBOS.Transact.MessageTest
    DBOS.Transact.MessageTestSim
    DBOS.Transact.MessageSimData
    DBOS.Transact.WaitCases
    DBOS.Transact.WaitTest
    DBOS.Transact.WaitTestSim
    DBOS.Transact.InstanceTest
    DBOS.Transact.WorkflowTest
    DBOS.Transact.WorkflowTestSim
    DBOS.Transact.WorkflowSimData
    DBOS.Transact.QueueTest
    DBOS.SystemDB.NotifyTest
    DBOS.SystemDB.NotifierTest
    DBOS.Transact.ManagementTest
    DBOS.Transact.ManagementTestSim
    DBOS.Transact.ManagementSimData
    DBOS.Transact.SimTest
    DBOS.Transact.SleepTest
    DBOS.Transact.SleepCases
    DBOS.Transact.SleepTestSim
    -- Deleted 2026-09-25: DBOS.SystemDBHasqlTest, DBOS.TransactTest
    -- (Bluefin seam; ADR-0012).
    -- Deleted 2026-09-29: DBOS.SystemDBTest, folded into
    -- DBOS.SystemDB.TypesTest as notificationTests (mirrors the
    -- DBOS.SystemDB.Types home of notificationRowForMessage).
  build-depends:
    breakpoint,
    bytestring,
    dbos-transact-hs,
    dbos-transact-hs:dbos-transact-internals,
    hasql,
    hasql-pool,
    hedgehog,
    io-classes,
    io-classes:si-timers,
    io-classes:strict-stm,
    io-sim,
    mtl,
    nothunks,
    rapid,
    silently,
    tasty,
    tasty-golden,
    tasty-hedgehog,
    tasty-hunit,
    text,
    uuid,

-- | One executable, one Main: both demo apps are compiled (the module names
-- are unique) and routed under their prefixes.
