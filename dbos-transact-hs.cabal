cabal-version: 3.6
name: dbos-transact-hs
version: 0.1.0.0
build-type: Simple

common commons
  default-language: GHC2024
  ghc-options: -Wall -threaded
  build-depends:
    aeson,
    async,
    base >=4.21 && <5,
    base64-bytestring,
    bluefin,
    bytestring,
    co-log,
    containers,
    exceptions,
    fast-logger,
    generic-data,
    hasql,
    hasql-dynamic-statements,
    hasql-pool,
    hasql-postgresql-types,
    hasql-th,
    io-classes,
    io-sim,
    mtl,
    postgresql-types,
    safe-wild-cards,
    stm,
    stm-containers,
    strict-wrapper,
    template-haskell,
    text,
    time,
    uuid,
    vector,

library
  import: commons
  hs-source-dirs: src
  exposed-modules:
    DBOS.SystemDB
    DBOS.SystemDB.Hasql
    DBOS.SystemDB.Queries
    DBOS.Transact
  other-modules:
    DBOS.Transact.OperationCheckpointParse
    DBOS.Transact.OperationCheckpointReplay
    DBOS.Transact.OperationCheckpointTypes
    DBOS.SystemDB.Types
    DBOS.Transact.WorkflowExecutionParse
    DBOS.Transact.WorkflowExecutionStatus
    DBOS.Transact.WorkflowExecutionTypes

test-suite test
  import: commons
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    DBOS.SchemaTest
    DBOS.SystemDBHasqlTest
    DBOS.SystemDBTest
    DBOS.TransactTest
  build-depends:
    breakpoint,
    dbos-transact-hs,
    hedgehog,
    nothunks,
    rapid,
    tasty,
    tasty-golden,
    tasty-hedgehog,
    tasty-hunit,
