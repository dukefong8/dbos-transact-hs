cabal-version: 3.6
name: dbos-transact-hs
version: 0.1.0.0
build-type: Simple

common commons
  default-language: GHC2024
  default-extensions:
    DuplicateRecordFields
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
  ghc-options: -Wall -threaded
  build-depends:
    aeson,
    async,
    base >=4.21 && <5,
    base64-bytestring,
    bluefin >=0.9 && <0.11,
    bytestring,
    co-log-core,
    containers,
    exceptions,
    fast-logger,
    generic-data,
    hasql >=1.10 && <1.11,
    hasql-dynamic-statements,
    hasql-pool,
    hasql-postgresql-types,
    ihp-typed-sql,
    io-classes,
    io-classes:mtl,
    io-classes:si-timers,
    io-classes:strict-mvar,
    io-classes:strict-stm,
    io-sim,
    mtl,
    postgresql-types,
    safe-wild-cards,
    stm,
    stm-containers,
    strict-wrapper,
    template-haskell,
    text,
    time,
    uuid,
    vector,

library
  import: commons
  hs-source-dirs: src
  exposed-modules:
    DBOS.SystemDB
    DBOS.SystemDB.Postgres
    DBOS.Transact
  other-modules:
    DBOS.Transact.Codec
    DBOS.Transact.Executor
    DBOS.Transact.Log
    DBOS.Transact.OperationCheckpointParse
    DBOS.Transact.OperationCheckpointReplay
    DBOS.Transact.OperationCheckpointTypes
    DBOS.Transact.Registry
    DBOS.Transact.Step
    DBOS.Transact.Store
    DBOS.Transact.Supervisor
    DBOS.Transact.Workflow
    DBOS.SystemDB.Types
    DBOS.SystemDB.Error
    DBOS.SystemDB.Retry
    DBOS.Transact.WorkflowExecutionParse
    DBOS.Transact.WorkflowExecutionTypes

test-suite test
  import: commons
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    DBOS.SchemaTest
    DBOS.CodecTest
    DBOS.LogTest
    DBOS.SimDB
    DBOS.SimTest
    DBOS.StarterTest
    DBOS.SystemDB.TypesTest
    DBOS.SystemDB.ErrorTest
    DBOS.SystemDB.RetryTest
    DBOS.SystemDBHasqlTest
    DBOS.SystemDBTest
    DBOS.TransactTest
  build-depends:
    breakpoint,
    dbos-transact-hs,
    hedgehog,
    nothunks,
    rapid,
    silently,
    tasty,
    tasty-golden,
    tasty-hedgehog,
    tasty-hunit,

executable dbos-hs-starter
  import: commons
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
    dbos-transact-hs,
    http-types,
    ihp-hsx,
    ihp-router,
    unix,
    wai,
    warp,
