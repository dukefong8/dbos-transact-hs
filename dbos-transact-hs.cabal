cabal-version: 3.6
name: dbos-transact-hs
version: 0.1.0.0
build-type: Simple

common commons
  default-language: GHC2024
  default-extensions:
    DuplicateRecordFields
    NoFieldSelectors
    NoImplicitPrelude
    OverloadedLabels
    OverloadedRecordDot
  ghc-options: -Wall -threaded
  build-depends:
    aeson,
    base >=4.21 && <5,
    base64-bytestring,
    bytestring,
    co-log-core,
    containers,
    contravariant,
    fast-logger,
    hasql >=1.10 && <1.11,
    hasql-pool,
    hasql-postgresql-types,
    hasql-transaction,
    ihp-typed-sql,
    io-classes,
    io-classes:mtl,
    io-classes:si-timers,
    io-classes:strict-mvar,
    io-classes:strict-stm,
    io-sim,
    mtl,
    postgresql-types,
    safe-wild-cards,
    stm-containers,
    strict-wrapper,
    template-haskell,
    text,
    time,
    uuid,
    vector,

library
  import: commons
  hs-source-dirs: src
  exposed-modules:
    DBOS.Prelude
    DBOS.SystemDB
    DBOS.SystemDB.IOSim
    DBOS.SystemDB.Postgres
    DBOS.Transact
  other-modules:
    DBOS.Transact.Checkpoint
    DBOS.Transact.Client
    DBOS.Transact.Codec
    DBOS.Transact.Config
    DBOS.Transact.Connection
    DBOS.Transact.Context
    DBOS.Transact.Dequeue
    DBOS.Transact.Error
    DBOS.Transact.Event
    DBOS.Transact.Executor
    DBOS.Transact.Handle
    DBOS.Transact.Identity
    DBOS.Transact.Instance
    DBOS.Transact.Log
    DBOS.Transact.Management
    DBOS.Transact.Message
    DBOS.Transact.OperationCheckpointParse
    DBOS.Transact.OperationCheckpointReplay
    DBOS.Transact.OperationCheckpointTypes
    DBOS.Transact.Queue
    DBOS.Transact.Recovery
    DBOS.Transact.Registry
    DBOS.Transact.Sleep
    DBOS.Transact.Step
    DBOS.Transact.Store
    DBOS.Transact.Supervisor
    DBOS.Transact.Wait
    DBOS.Transact.Workflow
    DBOS.Transact.WorkflowExecutionParse
    DBOS.Transact.WorkflowExecutionTypes
    DBOS.SystemDB.Error
    DBOS.SystemDB.Notify
    DBOS.SystemDB.Postgres.Notifier
    DBOS.SystemDB.Postgres.Statements
    DBOS.SystemDB.Retry
    DBOS.SystemDB.Types

test-suite test
  import: commons
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    -- PARKED while the Postgres backend is rewritten: ghciwatch and
    -- `cabal build test` cover the DBOS.SystemDB slice only.
    -- DBOS.SchemaTest
    DBOS.CodecTest
    -- DBOS.LogTest
    -- DBOS.SimDB
    -- DBOS.SimTest
    DBOS.StarterTest
    DBOS.SystemDB.TypesTest
    DBOS.SystemDB.ErrorTest
    DBOS.SystemDB.IOSimTest
    DBOS.SystemDB.RetryTest
    DBOS.SystemDB.PostgresTest
    DBOS.Transact.CheckpointTest
    DBOS.Transact.ClientTest
    DBOS.Transact.ConfigTest
    DBOS.Transact.ContextTest
    DBOS.Transact.DeadlinesTest
    DBOS.Transact.ContextTestIOSim
    DBOS.Transact.HandleTest
    DBOS.Transact.HandleTestIOSim
    DBOS.Transact.IdentityTest
    DBOS.Transact.RegistryTest
    DBOS.Transact.StepRetryTest
    DBOS.Transact.StepTestIOSim
    DBOS.Transact.StepTest
    DBOS.Transact.EventTest
    DBOS.Transact.MessageTest
    DBOS.Transact.MessageTestIOSim
    DBOS.Transact.WaitTest
    DBOS.Transact.WaitTestIOSim
    DBOS.Transact.InstanceTest
    DBOS.Transact.WorkflowTest
    DBOS.Transact.QueueTest
    DBOS.SystemDB.NotifyTest
    DBOS.SystemDB.NotifierTest
    DBOS.Transact.ManagementTest
    DBOS.Transact.ManagementTestIOSim
    DBOS.Transact.SimTest
    DBOS.Transact.SleepTest
    DBOS.Transact.SleepTestIOSim
    -- DBOS.SystemDBTest
    -- Deleted 2026-09-25: DBOS.SystemDBHasqlTest, DBOS.TransactTest
    -- (Bluefin seam; ADR-0012).
  build-depends:
    breakpoint,
    co-log-core,
    dbos-transact-hs,
    hasql,
    hasql-pool,
    hedgehog,
    io-classes,
    io-classes:si-timers,
    io-classes:strict-stm,
    io-sim,
    mtl,
    nothunks,
    rapid,
    silently,
    tasty,
    tasty-golden,
    tasty-hedgehog,
    tasty-hunit,
    text,
    uuid,

executable dbos-hs-starter
  import: commons
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
    dbos-transact-hs,
    http-types,
    ihp-hsx,
    ihp-router,
    unix,
    wai,
    warp,
