{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "hashline-test": {
      "description": "Minimal smoke-test agent for hashline read/edit/write",
      "mode": "primary",
      "model": "deepseek/deepseek-flash",
      "permission": {
        "*": "deny",
        "read": "allow",
        "edit": "allow",
        "write": "allow",
        "bash": "deny",
        "glob": "deny",
        "grep": "deny",
        "list": "deny"
      }
    }
  }
}
