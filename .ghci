:set -XGHC2024
:set -XDuplicateRecordFields
:set -XNoFieldSelectors
:set -XOverloadedLabels
:set -XOverloadedRecordDot
:set -XRecordWildCards
:set -XPartialTypeSignatures
:set -XExplicitNamespaces
:set -Wall

:set -Werror=deferred-out-of-scope-variables
:set -Werror=deferred-type-errors

:set -Wno-ambiguous-fields
:set -Wno-type-defaults
:set -Wno-name-shadowing
:set -Wno-unused-matches
:set -Wno-unused-imports
:set -Wno-unused-top-binds

:set -fdefer-type-errors
:set -fno-defer-typed-holes
:set -fplugin=Debug.Breakpoint

:set -outputdir .build
:set -isrc:test:demo-apps
:load test/Main.hs
