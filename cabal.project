packages:
  .
  demo-apps
  ../ihp/ihp-hsx/
  ../ihp/ihp-router/
  ../ihp/ihp-typed-sql/

-- ihp-typed-sql's spec spawns its own initdb/postgres cluster (AUTO_DB); a
-- libpq-only Homebrew install cannot satisfy it, and it is not part of this
-- repo's test story. ihp-hsx's tests stay enabled (they pass).
package ihp-typed-sql
  tests: False
